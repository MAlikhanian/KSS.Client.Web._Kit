/* Font Family Variables */
:root {
  --font-vazirmatn: 'Vazirmatn', 'Tahoma', 'Arial', sans-serif;
  --font-vazirmatn-fallback: 'Vazirmatn', 'Vazir', 'IRANSans', 'Tahoma', 'Arial', sans-serif;
}

/* Utility Classes */
.font-vazirmatn { 
  font-family: var(--font-vazirmatn); 
}

/* RTL Support */
[dir="rtl"] {
  font-family: var(--font-vazirmatn);
}

/* Language-specific font assignments */
[lang="fa"] { 
  font-family: var(--font-vazirmatn); 
}

/* Ensure Vazirmatn is applied to all form elements */
.font-vazirmatn input,
.font-vazirmatn textarea,
.font-vazirmatn select,
.font-vazirmatn button,
.font-vazirmatn label,
.font-vazirmatn p,
.font-vazirmatn span,
.font-vazirmatn div,
.font-vazirmatn h1,
.font-vazirmatn h2,
.font-vazirmatn h3,
.font-vazirmatn h4,
.font-vazirmatn h5,
.font-vazirmatn h6 {
  font-family: var(--font-vazirmatn);
}

/* Ensure form components inherit Vazirmatn font */
.font-vazirmatn [data-slot="form-label"],
.font-vazirmatn [data-slot="form-message"],
.font-vazirmatn [data-slot="form-description"] {
  font-family: var(--font-vazirmatn);
}

/* RTL support for Vazirmatn font */
[dir="rtl"] .font-vazirmatn {
  font-family: var(--font-vazirmatn);
  font-feature-settings: "liga" 1, "calt" 1;
}

/* Ensure Vazirmatn works well with different languages */
.font-vazirmatn {
  font-variant-ligatures: common-ligatures;
  text-rendering: optimizeLegibility;
}
