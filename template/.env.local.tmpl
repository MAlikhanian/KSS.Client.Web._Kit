# Local dev for the __DOMAIN__ domain app. Rendered by _Kit\sync-kit.ps1.

# REQUIRED. toAbsoluteUrl() and apiFetch() read this at runtime; without it
# every /media, /fonts and /api/* request resolves against the origin root and
# 404s (or worse, silently hits the Shell).
NEXT_PUBLIC_BASE_PATH=/__DOMAIN__

# Must be byte-identical to the Shell's, or this app cannot decrypt the session
# cookie the Shell issued. Copy it from the Shell's .env.local - do not invent one.
NEXTAUTH_SECRET=

# Backend services. Same values the Shell uses.
AUTH_API_BASE_URL=http://localhost:8010
COMMON_API_BASE_URL=http://localhost:8020
PERSON_API_BASE_URL=http://localhost:8040
COMPANY_API_BASE_URL=http://localhost:8050